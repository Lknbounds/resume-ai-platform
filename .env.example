# 复制为 .env 后填写真实值。不要把 .env 上传到 GitHub。
MYSQL_ROOT_PASSWORD=replace_with_strong_password
DB_NAME=resume_ai
DB_USER=resume_user
DB_PASSWORD=replace_with_strong_password

JWT_SECRET=replace_with_random_string_at_least_32_bytes

# 本地测试可保持 http://localhost；服务器改成 http://服务器IP 或 https://域名
CORS_ORIGINS=http://localhost

# 前端映射端口，80 被占用时可改成 8088
WEB_PORT=80

# 当前不接入外部 AI
AI_ENABLED=false
DASHSCOPE_API_KEY=