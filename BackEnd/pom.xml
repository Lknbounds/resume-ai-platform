<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.10</version>
        <relativePath/>
    </parent>

    <groupId>com.jianli</groupId>
    <artifactId>resume-ai-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>resume-ai-platform</name>
    <description>AI 辅助简历分析与社区互评平台</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-ai.version>1.1.2</spring-ai.version>
        <spring-ai-alibaba.version>1.1.2.3</spring-ai-alibaba.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.8.17</springdoc.version>

        <!--
          ★ 文件解析用（上传 PDF / DOCX）
          pdfbox    → PDF 文本提取（Apache 出品，Spring AI 的 pdf reader 底层也是它）
          poi-ooxml → DOCX 解析（含表格）
          ★ 版本必须自己指定 —— Spring Boot 的 BOM 不管理这两个。
        -->
        <!--
          ★ 文件解析用（上传 PDF / DOCX）
          pdfbox    → PDF 文本提取（Apache 出品，Spring AI 的 pdf reader 底层也是它）
          poi-ooxml → DOCX 解析（含表格）

          ★★ pdfbox 必须用 2.0.x，不能用 3.0.x！
             原因：OpenHTMLToPDF 1.0.10 内部依赖 pdfbox 2.0.24。
             如果我们在 dependencies 里声明 3.0.8（Maven 就近原则会用它），
             两个版本的类同时在 classpath，导出 PDF 时报：
                 NoSuchFieldError: COURIER_BOLD_OBLIQUE
             因为 3.x 删了 2.x 里的某些常量。

          ★ 2.x 和 3.x 的 API 差异（写代码时要注意）：
             2.x → PDDocument.load(File)
             3.x → Loader.loadPDF(File)
             网上教程两种都有，照抄前先确认项目用的是哪个版本。
        -->
        <pdfbox.version>2.0.37</pdfbox.version>
        <poi.version>5.5.1</poi.version>
        <openhtmltopdf.version>1.0.10</openhtmltopdf.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI 核心版本（chat client / embedding 抽象、retry、观测） -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
              【重要】dashscope starter 不在 spring-ai-alibaba-bom 里，而在 extensions-bom 里。
              （spring-ai-alibaba-bom 只管理 agent-framework / graph-core / studio 等构件）
              所以必须导入 extensions-bom，否则 starter 会报 "version is missing"。
            -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-extensions-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web / Security / JPA / Redis / 校验 / 健康检查 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- AI：DashScope / 通义千问 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>

        <!-- 数据库与迁移 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Swagger / OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          ═══════════════════════════════════════════════════════════
          【文件解析】上传 PDF / DOCX 后提取纯文本
          ═══════════════════════════════════════════════════════════

          ★ 为什么不用 spring-ai-pdf-document-reader？
            那个类（PagePdfDocumentReader）是为 RAG 设计的，
            它返回的是 Document 对象（带分页元数据），
            我们只要纯文本。直接用底层 PDFBox 更轻、更可控。

          ★ pdfbox 3.x 的 API 和 2.x 不同：
            2.x → PDDocument.load(file)
            3.x → Loader.loadPDF(file)
            网上大量教程还是 2.x 的写法，照抄会编译不过。
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!--
          ★ poi-ooxml 解析 .docx（Office Open XML）。
            注意：.doc（老格式）需要 poi-scratchpad 里的 HWPFDocument，
            那是另一套 API 且中文经常乱码 —— 本项目只支持 .docx。
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!--
          ═══════════════════════════════════════════════════════════
          【PDF 导出】HTML + CSS → PDF
          ═══════════════════════════════════════════════════════════

          ★ 为什么用 OpenHTMLToPDF 而不是直接用 PDFBox 画？

            PDFBox 是"底层绘图"：每个文字都要手动指定 x/y 坐标、
            字号、颜色、换行。画一份带表格和进度条的报告，
            要写几百行坐标计算，改一次布局就全乱。

            OpenHTMLToPDF 是"HTML → PDF"：写好 HTML+CSS，
            它负责排版、分页、换行。改布局只改 CSS。

          ★ 为什么不用 iText？
            iText 7 是 AGPL 协议，商用要买授权。本项目是开源的，不合适。

          ★ 中文字体必须内嵌（见 resources/fonts/simhei.ttf），
            否则 PDF 里中文全是空白或方框。
        -->
        <dependency>
            <groupId>com.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>${openhtmltopdf.version}</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <!--
                      ★★ 这里的 version 绝对不能省！★★

                      不写 version 时，Maven 能从 spring-boot-starter-parent 的
                      dependencyManagement 里解析到 lombok 的版本 —— 命令行编译没问题。

                      但 IDEA 的 JPS（它自己的编译器）解析不了这个继承来的版本，
                      于是【静默跳过注解处理】，导致：
                          java: 找不到符号
                            符号: 方法 getCode()
                            位置: 类型为 com.jianli.common.ErrorCode 的变量 ec

                      ★ 这是"Maven 能编译、IDEA 报错"最经典的原因。
                      ${lombok.version} 这个属性由 spring-boot-starter-parent 提供，
                      不需要我们自己在 properties 里定义。
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
